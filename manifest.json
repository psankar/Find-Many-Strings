{
  "manifest_version": 3,
  "name": "Find Many Strings",
  "version": "2.0",
  "description": "Search and highlight multiple strings in webpages",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
